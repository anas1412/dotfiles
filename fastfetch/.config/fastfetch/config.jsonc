{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // ── Tokyo Night ───────────────────────────────
  //  blue   #9DAAD0    cyan   #ED93A9
  //  purple #F0B799    teal   #D9D6B2
  //  green  #C7A0B8    orange #FF9E64
  //  fg     #D2D5E0    muted  #565F89
  // ──────────────────────────────────────────────

  "logo": {
    "source": "arch_small",
    "padding": {
      "top": 6,
      "right": 6,
      "left": 3
    },
    "color": {
      "1": "#9DAAD0",
      "2": "#F0B799"
    }
  },
  "display": {
    "separator": " → ",
    "color": {
      "keys": "#9DAAD0",
      "title": "#ED93A9",
      "output": "#D2D5E0"
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "#9DAAD0",
        "at": "#565F89",
        "host": "#F0B799"
      }
    },
    {
      "type": "separator",
      "string": "─"
    },
    // --- Software ---
    {
      "type": "os",
      "key": "󰣇 OS",
      "format": "CachyOS",
      "keyColor": "#9DAAD0"
    },
    {
      "type": "os",
      "key": "󰌽 Base",
      "format": "Arch Linux",
      "keyColor": "#ED93A9"
    },
    {
      "type": "kernel",
      "key": "󰘚 Kernel",
      "keyColor": "#F0B799"
    },
    {
      "type": "uptime",
      "key": "󰅐 Uptime",
      "keyColor": "#D9D6B2"
    },
    {
      "type": "packages",
      "key": "󰏗 Packages",
      "keyColor": "#C7A0B8"
    },
    "break",
    // --- Hardware ---
    {
      "type": "host",
      "key": "󰍹 Host",
      "keyColor": "#9DAAD0"
    },
    {
      "type": "cpu",
      "key": "󰻠 CPU",
      "temp": true,
      "format": "{1} {temperature}",
      "keyColor": "#ED93A9"
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU",
      "temp": true,
      "format": "{2} {temperature}",
      "keyColor": "#F0B799"
    },
    {
      "type": "memory",
      "key": "󰑭 Memory",
      "keyColor": "#D9D6B2"
    },
    {
      "type": "disk",
      "key": "󰋊 Storage",
      "keyColor": "#C7A0B8"
    },
    "break",
    // --- Environment ---
    {
      "type": "shell",
      "key": "󰆍 Shell",
      "keyColor": "#9DAAD0"
    },
    {
      "type": "de",
      "key": "󰟀 DE",
      "keyColor": "#ED93A9"
    },
    {
      "type": "wm",
      "key": "󰖯 WM",
      "keyColor": "#F0B799"
    },
    {
      "type": "terminal",
      "key": "󰞷 Terminal",
      "keyColor": "#D9D6B2"
    },
    {
      "type": "terminalfont",
      "key": "󰛖 Font",
      "keyColor": "#C7A0B8"
    },
    "break",
    "colors"
  ]
}
